# Backend server URL.
# Local dev: the Express server runs on port 5000.
# Vercel: set this to the deployed API project URL, e.g. https://<your-api>.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:5000

# Better Auth endpoint (server mounts it at /api/auth). Used by the React auth client.
# Vercel: set to <your-api>.vercel.app/api/auth
NEXT_PUBLIC_AUTH_URL=http://localhost:5000/api/auth

# ImgBB API key for client-side profile image uploads.
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here